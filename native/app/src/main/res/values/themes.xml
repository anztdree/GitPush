<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light-first (v34): jendela & splash terang; tema gelap dikoreksi runtime
         lewat WindowCompat di GitPushTheme (status bar & navigasi ikut tema). -->
    <style name="Theme.GitPush" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/gh_bg_light</item>
        <item name="android:statusBarColor">@color/gh_bg_light</item>
        <item name="android:navigationBarColor">@color/gh_bg_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
